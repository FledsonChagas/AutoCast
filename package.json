{
  "name": "autocast-harness",
  "version": "0.9.0",
  "description": "Framework standard and methodology for predictable, secure, and reviewable AI-assisted software delivery.",
  "type": "module",
  "bin": {
    "autocast": "./bin/autocast.mjs"
  },
  "scripts": {
    "route": "node ./bin/autocast.mjs route",
    "eval": "node ./bin/autocast.mjs eval",
    "eval:strict": "node ./bin/autocast.mjs eval --strict",
    "eval:false-positive": "node ./bin/autocast.mjs eval evals/v0.5/false-positive.json --strict",
    "eval:false-negative": "node ./bin/autocast.mjs eval evals/v0.5/false-negative.json --strict",
    "eval:security-assurance": "node ./bin/autocast.mjs eval evals/v0.6/security-assurance.json --strict",
    "eval:adapter-conformance": "node ./bin/autocast.mjs eval evals/v0.7/adapter-conformance.json --strict",
    "eval:adoption-evidence": "node ./bin/autocast.mjs eval evals/v0.8/adoption-evidence.json --strict",
    "report": "node ./bin/autocast.mjs report",
    "init:harness": "node ./bin/autocast.mjs init"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "ai-coding",
    "agentic-coding",
    "harness",
    "harness-engineering",
    "framework-standard",
    "methodology",
    "sdlc",
    "devsecops",
    "opencode",
    "claude-code",
    "cursor"
  ],
  "license": "Apache-2.0"
}
