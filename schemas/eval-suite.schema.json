{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FledsonChagas/AutoCast/schemas/eval-suite.schema.json",
  "title": "AutoCast Eval Suite",
  "type": "object",
  "required": ["name", "version", "cases"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "expectedRoute", "expectedRisk"],
        "properties": {
          "id": { "type": "string" },
          "input": { "type": "string" },
          "expectedRoute": {
            "type": "string",
            "enum": ["fast-lane", "standard", "secure-change", "critical-change", "review-only"]
          },
          "expectedRisk": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
